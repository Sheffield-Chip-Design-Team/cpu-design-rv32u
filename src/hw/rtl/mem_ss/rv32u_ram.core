CAPI=2:
name: sharc:rv32u:ram:0.1.0
description: >
  RV32u RAM: YOURS (design decision D1, spec 07). rv32u_ram.sv builds the RAM from a
  flip-flop array or from your IHP SRAM macro wrappers (sharc:rv32u:wrappers,
  src/hw/pd/wrappers/).

filesets:
  rtl:
    depend:
      - sharc:rv32u:wrappers
    files:
      - rv32u_ram.sv: {file_type: systemVerilogSource}

targets:
  default:
    filesets: [rtl]
