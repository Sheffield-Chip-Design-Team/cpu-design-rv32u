CAPI=2:
name: sharc:rv32u:mem_ss:0.1.0
description: >
  RV32u memory subsystem (provided): the valid/ready bus slave, the address decode, the
  I/O region and the loader port. The RAM inside it is sharc:rv32u:ram (yours, D1).

filesets:
  rtl:
    depend:
      - sharc:rv32u:ram
    files:
      - mem_config.svh:  {file_type: systemVerilogSource, is_include_file: true}
      - rv32u_mem_ss.sv: {file_type: systemVerilogSource}

targets:
  default:
    filesets: [rtl]
