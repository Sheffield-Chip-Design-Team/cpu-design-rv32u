CAPI=2:
name: sharc:rv32u:cpu_ss:0.1.0
description: >
  RV32u CPU subsystem: the student's control unit, datapath, ALU, register file and
  immediate generator. The reference solution (solution/, instructors only) provides a
  higher version of this core, which FuseSoC picks when solution/ is a cores root.

filesets:
  rtl:
    depend:
      - sharc:rv32u:pkg
    files:
      - rv32u_ctrl.svh:    {file_type: systemVerilogSource, is_include_file: true}
      - rv32u_regfile.sv:  {file_type: systemVerilogSource}
      - rv32u_alu.sv:      {file_type: systemVerilogSource}
      - rv32u_immgen.sv:   {file_type: systemVerilogSource}
      - rv32u_control.sv:  {file_type: systemVerilogSource}
      - rv32u_datapath.sv: {file_type: systemVerilogSource}
      - rv32u_cpu_ss.sv:   {file_type: systemVerilogSource}

targets:
  default:
    filesets: [rtl]
