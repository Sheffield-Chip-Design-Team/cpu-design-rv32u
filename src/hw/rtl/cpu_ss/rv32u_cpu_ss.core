CAPI=2:
name: sharc:rv32u:cpu_ss:0.1.0
description: >
  RV32u CPU subsystem: the student's CPU. List every file you add in cpu_ss/ here (and
  in info.yaml source_files), in dependency order, with rv32u_cpu_ss.sv last. The reference solution (solution/, instructors only) provides a
  higher version of this core, which FuseSoC picks when solution/ is a cores root.

filesets:
  rtl:
    depend:
      - sharc:rv32u:pkg
    files:
      - rv32u_ctrl.svh:    {file_type: systemVerilogSource, is_include_file: true}
      # - rv32u_alu.sv:     {file_type: systemVerilogSource}   (your files, for example)
      - rv32u_cpu_ss.sv:   {file_type: systemVerilogSource}

targets:
  default:
    filesets: [rtl]
