CAPI=2:
name: sharc:rv32u:soc:0.1.0
description: >
  RV32u system (CPU, memory and I/O subsystems, loader) and the Tiny Tapeout top level.
  The memory subsystem is decision D1: see sharc:rv32u:mem_ss (rtl/mem_ss/) and
  sharc:rv32u:wrappers (pd/wrappers/).

filesets:
  rtl:
    depend:
      - sharc:rv32u:pkg
      - sharc:rv32u:cpu
      - sharc:rv32u:mem_ss
      - sharc:rv32u:io_ss
    files:
      - rtl/rv32u_soc.sv:        {file_type: systemVerilogSource}
      - pd/tt_um_sharc_rv32u.sv: {file_type: systemVerilogSource}

  # Black boxes of the IHP macros for lint and synthesis; skipped when SIM is defined,
  # where the behavioural models (sharc:ip:ihp_sram) take their place.
  sram_bb:
    files:
      - pd/sram_bb.sv: {file_type: systemVerilogSource}

targets:
  # Dependents (the testbench) get this target's filesets.
  default: &default
    filesets: [rtl, sram_bb]
    toplevel: tt_um_sharc_rv32u

  # make lint
  lint:
    <<: *default
    description: Verilator lint of the whole design as Tiny Tapeout builds it.
    flow: lint
    flow_options:
      tool: verilator
      verilator_options:
        - -Wall
        - -Wno-DECLFILENAME
        - -Wno-UNUSEDPARAM
