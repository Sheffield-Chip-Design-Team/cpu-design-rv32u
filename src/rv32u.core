CAPI=2:
name: sharc:rv32u:soc:0.1.0
description: >
  RV32u system (core + memory subsystem + I/O + loader) and the Tiny Tapeout top level.
  The RAM backend is decision D1: scripts/select-memory.py rewrites the line marked
  MEM_OPTION below (and src/mem/mem_config.svh, src/config.json, info.yaml).

filesets:
  rtl:
    depend:
      - sharc:rv32u:pkg
      - sharc:rv32u:core
      - sharc:rv32u:io
    files:
      - mem/mem_config.svh:   {file_type: systemVerilogSource, is_include_file: true}
      - mem/rv32u_mem.sv:     {file_type: systemVerilogSource}
      - rv32u_soc.sv:         {file_type: systemVerilogSource}
      - tt_um_sharc_rv32u.sv: {file_type: systemVerilogSource}

  # Black boxes of the IHP macros for lint and synthesis; skipped when SIM is defined,
  # where the behavioural models (sharc:ip:ihp_sram) take their place.
  sram_bb:
    files:
      - sram_bb.sv: {file_type: systemVerilogSource}

  mem_macro_512x32:
    files:
      - mem/ram_macro_512x32.sv: {file_type: systemVerilogSource}
  mem_macro_2x512x16:
    files:
      - mem/ram_macro_2x512x16.sv: {file_type: systemVerilogSource}
  mem_flops:
    files:
      - mem/ram_flops.sv: {file_type: systemVerilogSource}

targets:
  # Dependents (the testbench) get this target's filesets.
  default: &default
    filesets:
      - rtl
      - sram_bb
      - mem_macro_512x32  # MEM_OPTION (scripts/select-memory.py)
    toplevel: tt_um_sharc_rv32u

  # make lint  (uv run fusesoc --cores-root . run --target=lint sharc:rv32u:soc)
  lint:
    <<: *default
    description: Verilator lint of the whole design as Tiny Tapeout builds it.
    flow: lint
    flow_options:
      tool: verilator
      verilator_options:
        - -Wall
        - -Wno-DECLFILENAME
        - -Wno-UNUSEDPARAM
